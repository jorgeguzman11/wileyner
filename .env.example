# ------------------------------------------------------------------
# Supabase — copia este archivo a `.env.local` y rellena tus valores.
# Los encuentras en: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------------

# URL pública del proyecto (ej. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave "anon" pública (segura para el navegador; la protege RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" — SOLO servidor. NUNCA la expongas en el cliente.
# Se usa en las rutas API protegidas (crear cita, moderar testimonios, admin).
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Panel de administración (/admin)
# ------------------------------------------------------------------

# Contraseña única para acceder al panel del fisioterapeuta.
# Elige una contraseña fuerte. PLACEHOLDER — cámbiala.
ADMIN_PASSWORD=cambia-esta-clave

# ------------------------------------------------------------------
# Sitio
# ------------------------------------------------------------------

# URL canónica del sitio en producción (para metadata / sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
